# File: .env.example
# Author: mrbacco04@gmail.com
# Date: 2026-10-05
#
# Copy this file to .env (next to run.py) and edit. `python run.py` and `flask --app wsgi ...` read .env by
# themselves; variables already set in the real environment win. Restart the server after changing it.
# NEVER put real keys or passwords in THIS file (it is committed to git). They belong in .env, which git ignores.
#
# Copied as it is, this file runs a LOCAL DEVELOPMENT site: no setting below is required.
# Lines starting with # are switched off; remove the # to use them. Booleans: 1 / 0.

# ==== FOR A REAL SERVER / DOCKER (production): uncomment and fill these three ======================
# APP_ENV=production
# a long random value, make one with:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# docker compose only: the password of the PostgreSQL database it creates
# POSTGRES_PASSWORD=
# In production the app refuses to start without a strong SECRET_KEY. For local use leave APP_ENV out.

# ---- your brand (white-label) -----------------------------------------------------------------
SITE_NAME=rockconnect
# the tail of the name shown in the accent colour, e.g. SITE_NAME=GigHub SITE_NAME_ACCENT=Hub
SITE_NAME_ACCENT=connect
SITE_TAGLINE=Your scene, your people: bands, venues and fans in one place.
ACCENT_COLOR=#ffc400
# public address of the site, used in the links of e-mails
# SITE_URL=https://example.com

# ---- legal pages (shown in the terms and privacy policy) -----------------------------------------
# OPERATOR_NAME=Your Company Ltd
# OPERATOR_ADDRESS=1 Example Street, Dublin, Ireland
# CONTACT_EMAIL=hello@example.com
MIN_AGE=18

# ---- behind a reverse proxy (nginx, Caddy, a PaaS router) ---------------------------------------
# TRUST_PROXY=1
# SESSION_COOKIE_SECURE and HSTS default to on in production

# ---- where the SQLite file and photos live (default: the instance/ folder next to the code) ---------
# INSTANCE_PATH=/var/lib/rockconnect

# ---- database: leave out for the local SQLite file, docker compose sets it for you --------------
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- e-mail: confirm addresses and reset passwords ------------------------------------------------
# without SMTP_HOST mails are only printed in the terminal (fine for development, not for real members)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# starttls | ssl | none
# SMTP_SECURITY=starttls
# default: on when SMTP_HOST is set. Members must confirm their address to post, comment and message
# REQUIRE_EMAIL_VERIFICATION=1
# swearing, insults and blasphemy: these starter blocked-word lists are added ONCE, the first time the site starts, and
# matching posts wait for a moderator. Curated: en it es fr de pt ru. More languages (nl pl tr sv da no fi hu cs ar fa hi th ja ko zh fil)
# are broader and noisier lists you add on the admin page. Empty = none. Edit them in Admin -> Blocked words.
# DEFAULT_WORD_LISTS=en,it,es,fr,de,pt,ru

# ---- photos in S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO) ----------------
# needs boto3 (included in the docker image); credentials via the usual AWS_* variables
# S3_BUCKET=my-bucket
# S3_PREFIX=uploads/
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- "gigs near me": turning a typed place name into map coordinates ------------------------------
# nominatim (default) = OpenStreetMap's free service (see its usage policy for heavy use), none = off
# GEOCODER=nominatim
# your own Nominatim-compatible server:
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---- gigs imported from Ticketmaster, so "gigs near you" is not empty (docs/EVENT-IMPORT.md) --------
# free key: https://developer.ticketmaster.com . READ the terms in docs/EVENT-IMPORT.md before selling.
# Put your real keys in .env, not here. With a key, ANY city works: it is fetched when someone first searches there.
# TICKETMASTER_API_KEY=
# UK and Ireland, free key from skiddle.com/api/join.php
# SKIDDLE_API_KEY=
# worldwide, keys on application only (songkick.com/api_key_requests/new)
# SONGKICK_API_KEY=
# worldwide, paid with a free trial (docs.predicthq.com): a venue's concerts, with no ticket links
# PREDICTHQ_API_KEY=
# 0 = never fetch because of a search (then use IMPORT_AREAS + the daily `flask --app wsgi import-events`)
# IMPORT_ON_DEMAND=1
# how long a fetched area is remembered before the next search there refreshes it
# IMPORT_COVERAGE_HOURS=12
# optional: places to keep fresh from cron even when nobody searched there. Name=latitude,longitude,radius_km separated by ;
# IMPORT_AREAS=London=51.5072,-0.1276,40;Dublin=53.3498,-6.2603,30
# IMPORT_DAYS_AHEAD=120
# imported events not refreshed within this many hours are deleted (the provider only allows short-term storage)
# IMPORT_MAX_AGE_HOURS=48

# ---- sessions and limits -----------------------------------------------------------------------
# stay signed in this long without visiting (default 43200 = 30 days); every visit renews it
SESSION_MINUTES=43200
# RATE_LIMIT_<NAME>=count/seconds   names: SIGNIN_IP SIGNIN_USER SIGNUP_IP FORGOT_IP FORGOT_EMAIL VERIFY_USER
#                                          POST_USER COMMENT_USER MESSAGE_USER REPORT_USER EXPORT_USER PASSWORD_USER
#                                          NEARBY_USER GEOCODE_USER ONDEMAND_SITE ARTIST_SYNC_USER
# RATE_LIMIT_SIGNIN_USER=10/900

# ---- container -------------------------------------------------------------------------------
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=2
# BAC_LOG=0
